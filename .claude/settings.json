{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(**/*.md)",
      "Edit(/design/schemas/**)",
      "Bash(zig *)",
      "Bash(SDDE_REQUEST_PROJECTION=* zig build *)",
      "Bash(./scripts/test-integration.sh *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(sed -n *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(diff *)",
      "Bash(jq *)",
      "Bash(echo *)",
      "Bash(date *)",
      "Bash(shasum *)",
      "Bash(mkdir -p evaluations/*)"
    ],
    "ask": [
      "Bash(zig build run *)",
      "Bash(zig build * run)",
      "Bash(zig build * run *)",
      "Bash(zig build e2e-spec*)",
      "Bash(zig build * e2e-spec*)",
      "Bash(zig build e2e-call*)",
      "Bash(zig build * e2e-call*)",
      "Bash(zig build evaluate-spec*)",
      "Bash(zig build * evaluate-spec*)",
      "Bash(zig build provider-compatibility*)",
      "Bash(zig build * provider-compatibility*)",
      "Bash(zig build baseline*)",
      "Bash(zig build * baseline*)",
      "Bash(*scripts/e2e-spec.sh*)",
      "Bash(*scripts/e2e-call.sh*)",
      "Bash(*scripts/provider-compatibility.sh*)",
      "Bash(*scripts/baseline.sh*)",
      "Bash(*zig-out/bin/*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec*)",
      "Bash(find * -ok*)",
      "Bash(find * -fprint*)",
      "Bash(find * -fls *)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh release*)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)"
    ],
    "deny": [
      "Read(/.env.e2e)",
      "Edit(/.env.e2e)",
      "Bash(*.env.e2e)",
      "Bash(*.env.e2e *)",
      "Bash(git *)",
      "Edit(/zig-pkg/**)",
      "Edit(/.zig-cache/**)",
      "Edit(/zig-out/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-zig.sh",
            "timeout": 30,
            "statusMessage": "zig fmt"
          }
        ]
      }
    ]
  }
}
