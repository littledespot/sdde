{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(**/*.md)",
      "Edit(/design/schemas/**)",
      "Edit(/evaluations/**)",
      "Skill(evaluate-e2e)",
      "Skill(evaluate-e2e *)",
      "Bash(zig *)",
      "Bash(SDDE_REQUEST_PROJECTION=* zig build *)",
      "Bash(./scripts/test-integration.sh *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(sed -n *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(diff *)",
      "Bash(jq *)",
      "Bash(echo *)",
      "Bash(date *)",
      "Bash(shasum *)",
      "Bash(mkdir -p evaluations/*)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git show HEAD:*)"
    ],
    "ask": [
      "Bash(zig build run *)",
      "Bash(zig build * run)",
      "Bash(zig build * run *)",
      "Bash(zig build e2e-spec*)",
      "Bash(zig build * e2e-spec*)",
      "Bash(zig build e2e-call*)",
      "Bash(zig build * e2e-call*)",
      "Bash(zig build evaluate-spec*)",
      "Bash(zig build * evaluate-spec*)",
      "Bash(zig build provider-compatibility*)",
      "Bash(zig build * provider-compatibility*)",
      "Bash(zig build baseline*)",
      "Bash(zig build * baseline*)",
      "Skill(live-e2e)",
      "Skill(live-e2e *)",
      "Bash(git restore*)",
      "Bash(*scripts/e2e-call.sh*)",
      "Bash(*scripts/provider-compatibility.sh*)",
      "Bash(*scripts/baseline.sh*)",
      "Bash(*zig-out/bin/*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec*)",
      "Bash(find * -ok*)",
      "Bash(find * -fprint*)",
      "Bash(find * -fls *)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh release*)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)"
    ],
    "deny": [
      "Read(/.env.e2e)",
      "Edit(/.env.e2e)",
      "Bash(*.env.e2e)",
      "Bash(*.env.e2e *)",
      "Bash(git -*)",
      "Bash(git add*)",
      "Bash(git am*)",
      "Bash(git apply*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git cherry-pick*)",
      "Bash(git clean*)",
      "Bash(git clone*)",
      "Bash(git commit*)",
      "Bash(git config*)",
      "Bash(git fetch*)",
      "Bash(git filter-branch*)",
      "Bash(git gc*)",
      "Bash(git init*)",
      "Bash(git merge*)",
      "Bash(git mv*)",
      "Bash(git pull*)",
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(git remote*)",
      "Bash(git reset*)",
      "Bash(git revert*)",
      "Bash(git rm*)",
      "Bash(git stash*)",
      "Bash(git submodule*)",
      "Bash(git switch*)",
      "Bash(git tag*)",
      "Bash(git update-ref*)",
      "Bash(git worktree*)",
      "Bash(git diff*--output*)",
      "Bash(git diff*--no-index*)",
      "Bash(git diff*--ext-diff*)",
      "Bash(git show*--output*)",
      "Edit(/.claude/live-e2e-approvals/**)",
      "Edit(/zig-pkg/**)",
      "Edit(/.zig-cache/**)",
      "Edit(/zig-out/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/live-e2e-approval.py record",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-zig.sh",
            "timeout": 30,
            "statusMessage": "zig fmt"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/live-e2e-approval.py record",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
