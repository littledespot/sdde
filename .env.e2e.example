# Copy to .env.e2e and fill in only the credentials needed for your run.
# scripts/e2e-spec.sh loads this file automatically. For direct Zig commands,
# load explicitly from the repository root: . ./.env.e2e
# This is a shell file; keep values single-quoted and never commit real keys.

# Retained OpenAI evaluator credential port; direct OpenAI live tests are disallowed.
export TEST_OPENAI_API_KEY=''

# Internal Bedrock generation, standalone rubric evaluation and captured-call
# diagnostics. The deployed sdde application does not read this variable.
export TEST_AWS_BEARER_TOKEN_BEDROCK=''

# Internal generation through the Anthropic Messages API (ADR 0028), read only when
# a case's slots select the "anthropic" provider. The live-test cost policy permits
# only claude-haiku-5-5, for generation. The deployed sdde application reads
# ANTHROPIC_API_KEY instead and never this variable.
export TEST_ANTHROPIC_API_KEY=''

# Standalone supplied-spec evaluator (zig build evaluate-spec) only; E2E runs do
# not grade and do not read these. Evaluation selection is explicit; there is no
# default model.
# The live-test policy permits only aws-bedrock / openai.gpt-oss-20b-1:0,
# using Converse and native JSON Schema from source region ap-southeast-2.
# Set the blank model below explicitly to openai.gpt-oss-20b-1:0 for a run.
# Sonnet, Sol, Haiku, Luna, direct OpenAI and unknown aliases reject
# before credentials or network use. See design/harness/evaluator.md.
export TEST_EVALUATION_PROVIDER='bedrock'
export TEST_EVALUATION_MODEL=''
export TEST_EVALUATION_REGION='ap-southeast-2'

# Judge JSON selects reasoning_effort:"low" and temperature:null for this profile.
# The registered engine policy supplies temperature 0.1.
# Timeout, retry and token-budget settings remain in that JSON. Provider/model fields
# are not accepted there. Ordinary verification is offline and needs no credential.
