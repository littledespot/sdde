# Copy to .env.e2e and fill in only the credentials needed for your run.
# scripts/e2e-spec.sh loads this file automatically. For direct Zig commands,
# load explicitly from the repository root: . ./.env.e2e
# This is a shell file; keep values single-quoted and never commit real keys.

# Retained OpenAI evaluator credential port; direct OpenAI live tests are disallowed.
export TEST_OPENAI_API_KEY=''

# Internal Bedrock generation, rubric evaluation and captured-call diagnostics.
# The deployed sdde application does not read this variable.
export TEST_AWS_BEARER_TOKEN_BEDROCK=''

# Evaluation selection is explicit; there is no default model.
# The live-test policy permits only aws-bedrock / global.openai.gpt-6-luna,
# using Converse and native JSON Schema from source region ap-southeast-2.
# Set the blank model below explicitly to global.openai.gpt-6-luna for a run.
# This global profile may route worldwide; it is not an Australian-residency guarantee.
# Sonnet, Sol, Haiku, direct OpenAI, historical models and unknown aliases reject
# before credentials or network use. See design/harness/evaluator.md and e2e.md.
export TEST_EVALUATION_PROVIDER='bedrock'
export TEST_EVALUATION_MODEL=''
export TEST_EVALUATION_REGION='ap-southeast-2'

# Judge JSON must use reasoning_effort:null and temperature:null for this profile.
# The documented provider default is medium reasoning; no unverified override is sent.
# Timeout, retry and token-budget settings remain in that JSON. Provider/model fields
# are not accepted there. Ordinary verification is offline and needs no credential.
