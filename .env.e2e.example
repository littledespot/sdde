# Copy to .env.e2e and fill in only the credentials needed for your run.
# Load explicitly from the repository root: . ./.env.e2e
# This is a shell file; keep values single-quoted and never commit real keys.

# Internal live supplied-spec rubric evaluation through OpenAI.
export TEST_OPENAI_API_KEY=''

# Internal Bedrock evaluation and workflow tests.
# The deployed sdde application does not read this variable.
export TEST_AWS_BEARER_TOKEN_BEDROCK=''

# Evaluation selection: openai or bedrock.
# Set an exact model ID before a live run; there is no model default.
export TEST_EVALUATION_PROVIDER='openai'
export TEST_EVALUATION_MODEL=''
# Bedrock requires the registered region for the selected model; OpenAI leaves
# this empty. See README.md for the supported Bedrock model/region pairs.
export TEST_EVALUATION_REGION=''

# Low-cost AWS Bedrock reference, checked 2026-09-09.
# Standard on-demand prices in USD per 1 million input / output tokens:
# mistral.voxtral-mini-3b-2507 | us-east-1 (N. Virginia) | $0.04 / $0.04
# amazon.nova-micro-v1:0      | us-east-1 (N. Virginia) | $0.035 / $0.14
# Voxtral Mini Flex pricing: $0.02 / $0.02, with flexible latency.
# These two model/region pairs are not yet registered in SDDE; the evaluator
# rejects them before an API call. Use a supported pair from README.md to run.
# Sources (recheck prices and availability before use):
# https://aws.amazon.com/bedrock/pricing/
# https://docs.aws.amazon.com/bedrock/latest/userguide/models-region-compatibility.html

# Evaluation reasoning, temperature, timeout, retry and token-budget settings
# remain in the judge JSON. Provider/model fields are not accepted there.
# Ordinary tests and verification are offline and need neither credential.
