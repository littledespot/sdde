{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sddtoolkit.dev/config/sddtoolkit-config.schema.json",
  "title": "SDDToolKit configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["logs", "models", "paths"],
  "properties": {
    "logs": { "$ref": "#/$defs/logs" },
    "models": { "$ref": "#/$defs/models" },
    "paths": { "$ref": "#/$defs/paths" },
    "principles": { "anyOf": [{ "$ref": "#/$defs/principles" }, { "type": "null" }] }
  },
  "$defs": {
    "logs": {
      "type": "object",
      "$comment": "File logging is mandatory. console enables only an additional pipe-delimited mirror.",
      "additionalProperties": false,
      "required": ["level", "console", "promptCapture"],
      "properties": {
        "level": { "type": "string" },
        "console": { "type": "boolean" },
        "promptCapture": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": ["request", "response", "reference_body", "code_body"]
          }
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slots"],
      "properties": {
        "slots": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/modelSlot" }
        }
      }
    },
    "modelSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "reasoningEffort": { "type": "string" }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specs",
        "references",
        "specsArchive",
        "workflows",
        "toolchainPreset",
        "principles",
        "templates",
        "providers"
      ],
      "properties": {
        "specs": { "type": "string" },
        "references": { "type": "string" },
        "specsArchive": { "type": "string" },
        "workflows": { "type": "string" },
        "toolchainPreset": { "type": "string" },
        "principles": { "type": "string" },
        "templates": { "type": "string" },
        "providers": { "type": "string" }
      }
    },
    "principleCategory": {
      "enum": [
        "core",
        "architecture",
        "project_structure",
        "security",
        "validation",
        "observability",
        "user_interface",
        "custom"
      ]
    },
    "principles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filenameHints",
        "selections"
      ],
      "properties": {
        "filenameHints": {
          "type": "object",
          "maxProperties": 256,
          "additionalProperties": {
            "$ref": "#/$defs/principleCategory"
          }
        },
        "selections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "environment",
              "fileKind",
              "categories"
            ],
            "properties": {
              "stage": {
                "enum": [
                  "spec",
                  "plan",
                  "tasks",
                  "implement"
                ]
              },
              "environment": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "fileKind": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "categories": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/principleCategory"
                }
              }
            }
          }
        }
      }
    }
  }
}
