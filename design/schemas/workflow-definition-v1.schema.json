{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sddtoolkit.dev/workflows/workflow-definition-v1.schema.json",
  "title": "SDDE concise workflow definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "shortcode",
    "invoke",
    "policy",
    "start",
    "steps"
  ],
  "properties": {
    "schema": { "const": "workflow/v1" },
    "id": { "$ref": "#/$defs/localId" },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "shortcode": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{4}$"
    },
    "invoke": { "$ref": "#/$defs/registeredRef" },
    "policy": { "$ref": "#/$defs/registeredRef" },
    "start": { "$ref": "#/$defs/localId" },
    "resources": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "$ref": "#/$defs/localId" },
      "additionalProperties": { "$ref": "#/$defs/resourceName" }
    },
    "steps": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "propertyNames": { "$ref": "#/$defs/localId" },
      "additionalProperties": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "localId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "registeredRef": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*@[1-9][0-9]*$"
    },
    "resourceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "parameterValue": {
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      ]
    },
    "transitionTarget": {
      "oneOf": [
        { "$ref": "#/$defs/localId" },
        {
          "enum": [
            "end.ok",
            "end.needs-user",
            "end.invalid",
            "end.blocked",
            "end.failed",
            "end.cancelled"
          ]
        }
      ]
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "ok": { "$ref": "#/$defs/transitionTarget" },
        "needs-user": { "$ref": "#/$defs/transitionTarget" },
        "invalid": { "$ref": "#/$defs/transitionTarget" },
        "blocked": { "$ref": "#/$defs/transitionTarget" },
        "failed": { "$ref": "#/$defs/transitionTarget" },
        "cancelled": { "$ref": "#/$defs/transitionTarget" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use", "on"],
      "properties": {
        "use": { "$ref": "#/$defs/registeredRef" },
        "with": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": { "$ref": "#/$defs/localId" },
          "additionalProperties": { "$ref": "#/$defs/parameterValue" }
        },
        "on": { "$ref": "#/$defs/outcomes" }
      }
    }
  }
}
