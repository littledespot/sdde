{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sddtoolkit.dev/workflows/workflow-definition-v1.schema.json",
  "title": "SDDE workflow definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workflowId",
    "workflowVersion",
    "workflowShortcode",
    "invocationContractNodeId",
    "workflowPolicyProfileId",
    "entryWorkflowNodeId",
    "nodes",
    "transitions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "workflowId": { "$ref": "#/$defs/localId" },
    "workflowVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "workflowShortcode": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{4}$"
    },
    "invocationContractNodeId": { "$ref": "#/$defs/registeredRef" },
    "workflowPolicyProfileId": { "$ref": "#/$defs/registeredRef" },
    "entryWorkflowNodeId": { "$ref": "#/$defs/localId" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/node" }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1536,
      "items": { "$ref": "#/$defs/transition" }
    }
  },
  "$defs": {
    "localId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "registeredRef": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*@[1-9][0-9]*$"
    },
    "outcomeTag": {
      "enum": [
        "ok",
        "needs_user",
        "invalid",
        "blocked",
        "failed",
        "cancelled"
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflowNodeId",
        "pipelineNodeContractId",
        "parameters"
      ],
      "properties": {
        "workflowNodeId": { "$ref": "#/$defs/localId" },
        "pipelineNodeContractId": { "$ref": "#/$defs/registeredRef" },
        "parameters": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/parameterBinding" }
        }
      }
    },
    "parameterBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameterId", "value"],
      "properties": {
        "parameterId": { "$ref": "#/$defs/localId" },
        "value": { "$ref": "#/$defs/parameterValue" }
      }
    },
    "parameterValue": {
      "oneOf": [
        { "$ref": "#/$defs/booleanParameterValue" },
        { "$ref": "#/$defs/integerParameterValue" },
        { "$ref": "#/$defs/enumParameterValue" },
        { "$ref": "#/$defs/registeredIdParameterValue" }
      ]
    },
    "booleanParameterValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "boolean" },
        "value": { "type": "boolean" }
      }
    },
    "integerParameterValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "integer" },
        "value": {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        }
      }
    },
    "enumParameterValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "enum" },
        "value": { "$ref": "#/$defs/localId" }
      }
    },
    "registeredIdParameterValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "registered_id" },
        "value": { "$ref": "#/$defs/registeredRef" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromWorkflowNodeId", "outcomeTag", "target"],
      "properties": {
        "fromWorkflowNodeId": { "$ref": "#/$defs/localId" },
        "outcomeTag": { "$ref": "#/$defs/outcomeTag" },
        "target": { "$ref": "#/$defs/transitionTarget" }
      }
    },
    "transitionTarget": {
      "oneOf": [
        { "$ref": "#/$defs/nodeTarget" },
        { "$ref": "#/$defs/terminalTarget" }
      ]
    },
    "nodeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "workflowNodeId"],
      "properties": {
        "kind": { "const": "node" },
        "workflowNodeId": { "$ref": "#/$defs/localId" }
      }
    },
    "terminalTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "outcomeTag"],
      "properties": {
        "kind": { "const": "terminal" },
        "outcomeTag": { "$ref": "#/$defs/outcomeTag" }
      }
    }
  }
}
