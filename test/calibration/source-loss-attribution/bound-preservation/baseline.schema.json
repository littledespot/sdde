{
  "$defs": {
    "preservation_finding": {
      "oneOf": [
        {
          "$ref": "#/$defs/supported"
        },
        {
          "$ref": "#/$defs/candidate_omission"
        },
        {
          "$ref": "#/$defs/inconclusive"
        }
      ]
    },
    "finding": {
      "oneOf": [
        {
          "$ref": "#/$defs/supported"
        },
        {
          "$ref": "#/$defs/ambiguous"
        },
        {
          "$ref": "#/$defs/conflicting"
        },
        {
          "$ref": "#/$defs/unsupported"
        },
        {
          "$ref": "#/$defs/candidate_omission"
        },
        {
          "$ref": "#/$defs/inconclusive"
        }
      ]
    },
    "applicability_finding": {
      "oneOf": [
        {
          "$ref": "#/$defs/supported"
        },
        {
          "$ref": "#/$defs/ambiguous"
        },
        {
          "$ref": "#/$defs/conflicting"
        },
        {
          "$ref": "#/$defs/unsupported"
        },
        {
          "$ref": "#/$defs/candidate_omission"
        },
        {
          "$ref": "#/$defs/inconclusive"
        },
        {
          "$ref": "#/$defs/not_applicable"
        }
      ]
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "detail": {
      "type": "object",
      "properties": {
        "detail": {
          "$ref": "#/$defs/detail_value"
        }
      },
      "required": [
        "detail"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "properties": {
        "source_ids": {
          "$ref": "#/$defs/ordinal_list"
        }
      },
      "required": [
        "source_ids"
      ],
      "additionalProperties": false
    },
    "detail_value": {
      "type": "string",
      "maxLength": 2000
    },
    "required_detail_value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "loss": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "candidate"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unlocalized"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "localized"
            },
            "location": {
              "$ref": "#/$defs/loss_location"
            },
            "comparison": {
              "$ref": "#/$defs/loss_comparison"
            }
          },
          "required": [
            "kind",
            "location",
            "comparison"
          ],
          "additionalProperties": false
        }
      ]
    },
    "loss_location": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "extraction_claim"
            },
            "bytes": {
              "type": "string",
              "maxLength": 256
            }
          },
          "required": [
            "kind",
            "bytes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "token_classification"
            },
            "source_id": {
              "$ref": "#/$defs/ordinal"
            },
            "extractor_id": {
              "const": "markdown_inline_code_v1"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            }
          },
          "required": [
            "kind",
            "source_id",
            "extractor_id",
            "ordinal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "reconciliation_signal"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            }
          },
          "required": [
            "kind",
            "ordinal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "reconciliation_disposition"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            }
          },
          "required": [
            "kind",
            "ordinal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "reconciliation_conflict"
            },
            "ordinal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967295
            }
          },
          "required": [
            "kind",
            "ordinal"
          ],
          "additionalProperties": false
        }
      ]
    },
    "loss_comparison": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "source_producer_comparison"
        },
        "source": {
          "type": "object",
          "properties": {
            "chunk_id": {
              "type": "object",
              "properties": {
                "bytes": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              },
              "required": [
                "bytes"
              ],
              "additionalProperties": false
            },
            "lines": {
              "type": "object",
              "properties": {
                "first": {
                  "$ref": "#/$defs/ordinal"
                },
                "last": {
                  "$ref": "#/$defs/ordinal"
                }
              },
              "required": [
                "first",
                "last"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "chunk_id",
            "lines"
          ],
          "additionalProperties": false
        },
        "producer_loss": {
          "$ref": "#/$defs/required_detail_value"
        }
      },
      "required": [
        "kind",
        "source",
        "producer_loss"
      ],
      "additionalProperties": false
    },
    "principle_finding": {
      "type": "object",
      "properties": {
        "decision": {
          "enum": [
            "compatible",
            "conflicting",
            "uncertain"
          ]
        },
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "chunk": {
                "$ref": "#/$defs/ordinal"
              },
              "first_line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "last_line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            },
            "required": [
              "chunk",
              "first_line",
              "last_line"
            ],
            "additionalProperties": false
          },
          "maxItems": 4294967295
        },
        "detail": {
          "$ref": "#/$defs/detail_value"
        }
      },
      "required": [
        "decision",
        "citations",
        "detail"
      ],
      "additionalProperties": false
    },
    "principle_selection": {
      "type": "object",
      "properties": {
        "citations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "chunk": {
                "$ref": "#/$defs/ordinal"
              },
              "first_line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "last_line": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              }
            },
            "required": [
              "chunk",
              "first_line",
              "last_line"
            ],
            "additionalProperties": false
          },
          "maxItems": 4294967295
        }
      },
      "required": [
        "citations"
      ],
      "additionalProperties": false
    },
    "question_value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "gap_detail": {
      "type": "object",
      "properties": {
        "detail": {
