{
  "logs": {
    "level": "debug",
    "console": true
  },
  "workflowTokenBudget": 125000,
  "temperature": 0.1,
  "temperatureRunawayRetry": 1,
  "models": {
    "slots": {
      "audit_analysis": { "provider": "anthropic", "model": "claude-haiku-5-5" },
      "drift_analysis": { "provider": "anthropic", "model": "claude-haiku-5-5" },
      "spec_generation": {
        "provider": "anthropic",
        "model": "claude-haiku-5-5",
        "reasoningEffort": "low"
      },
      "repair": { "provider": "anthropic", "model": "claude-haiku-5-5", "reasoningEffort": "low" },
      "design_section_generation": { "provider": "anthropic", "model": "claude-haiku-5-5" },
      "implementation": { "provider": "anthropic", "model": "claude-haiku-5-5" }
    }
  },
  "validation": { "sourcePreservationCheck": false },
  "paths": {
    "specs": "specs/",
    "references": "references/",
    "specsArchive": "specs/_archive/",
    "workflows": ".sddtoolkit/workflows",
    "toolchainPreset": ".sddtoolkit/toolchainPreset",
    "principles": ".sddtoolkit/principles",
    "templates": ".sddtoolkit/templates",
    "providers": ".sddtoolkit/providers/.sddproviders.json"
  }
}
